#!/bin/bash

set -euo pipefail
umask 077

BACKUP_MOUNT="{{ proxmox_config_backup_mount }}"
DEST="${BACKUP_MOUNT}/{{ proxmox_config_backup_subdir }}"
KEEP_BACKUPS={{ proxmox_config_backup_keep }}
HOST="{{ inventory_hostname }}"

INFO="/root/${HOST}-backup-info"
DATE="$(date +%F_%H-%M)"
BACKUP="${DEST}/${HOST}-config-${DATE}.tar.gz"

if ! mountpoint -q "$BACKUP_MOUNT"; then
    logger -t "${HOST}-config-backup"         "ERRO: $BACKUP_MOUNT não está montado"
    exit 1
fi

mkdir -p "$DEST"
rm -rf "$INFO"
mkdir -p "$INFO"

pveversion -v > "$INFO/pveversion.txt"
pvesm status > "$INFO/storage-status.txt"
pct list > "$INFO/lxc-list.txt"
qm list > "$INFO/vm-list.txt"
lsblk -f > "$INFO/lsblk.txt"
ip -br addr > "$INFO/ip-addresses.txt"
ip route > "$INFO/routes.txt"

dpkg-query -W -f='${binary:Package}\t${Version}\n'     > "$INFO/packages.txt"

cp -a /var/lib/pve-cluster/config.db     "$INFO/pve-cluster-config.db"

tar     --numeric-owner     -czf "$BACKUP"     /etc/pve     /etc/network/interfaces     /etc/hosts     /etc/hostname     /etc/resolv.conf     /etc/zabbix     /etc/apt     /root/homelab-ca     "$INFO"

find "$DEST"     -maxdepth 1     -type f     -name "${HOST}-config-*.tar.gz"     -printf '%T@ %p\n'     | sort -nr     | tail -n "+$((KEEP_BACKUPS + 1))"     | cut -d' ' -f2-     | xargs -r rm -f

logger -t "${HOST}-config-backup"     "Backup concluído: $BACKUP"
